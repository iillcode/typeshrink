{
  "name": "element-click-browser",
  "displayName": "Element Browser",
  "description": "A webview-based browser for previewing your app inside VS Code — with login sessions that survive reloads",
  "version": "0.0.1",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:elementClickBrowser.open",
    "onCommand:elementClickBrowser.stop",
    "onCommand:elementClickBrowser.clearSession"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "elementClickBrowser.open",
        "title": "Element Browser: Open App URL"
      },
      {
        "command": "elementClickBrowser.stop",
        "title": "Element Browser: Stop Preview"
      },
      {
        "command": "elementClickBrowser.clearSession",
        "title": "Element Browser: Clear Saved Login Session"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "elementClickBrowserContainer",
          "title": "Element Browser",
          "icon": "$(browser)"
        }
      ]
    },
    "views": {
      "elementClickBrowserContainer": [
        {
          "type": "webview",
          "id": "elementClickBrowser.sidebarView",
          "name": "Design"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
